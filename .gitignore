# Node
node_modules/
dist/
*.local

# Rust / Tauri
src-tauri/target/
src-tauri/gen/

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs（dev-logs/ 为项目自留日志目录，不整体忽略）
*.log
!dev-logs/
!dev-logs/*.log

# 轮17 增补：本地工作/构建/凭据工件不入库
# 轮18：.tools 为本地采集/排版脚本与中间截图（含桌面截图与配置副本），整体不入库
# 注意：.gitignore 不支持行尾注释——注释必须独占一行，否则整行会被当作模式
.tools/
build/
*.msix
scripts/msix/layout/
